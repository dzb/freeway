<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.jujin</groupId>
    <artifactId>freeway-2-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Freeway 2</name>
    <description>
        A brand-new, modern, lightweight Java application framework built on JDK 25+.
        Compose-first, no classpath scanning, zero external dependencies for core modules.
    </description>
    <url>https://github.com/bob-dev-77/freeway2</url>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <junit.version>5.12.0</junit.version>
        <slf4j.version>2.0.17</slf4j.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Freeway2 internal modules -->
            <dependency>
                <groupId>com.jujin</groupId>
                <artifactId>freeway2-commons</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jujin</groupId>
                <artifactId>freeway2-ioc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jujin</groupId>
                <artifactId>freeway2-boot</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jujin</groupId>
                <artifactId>freeway2-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jujin</groupId>
                <artifactId>freeway2-web-engine-robaho</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jujin</groupId>
                <artifactId>freeway2-web-engine-undertow</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jujin</groupId>
                <artifactId>freeway2-web-engine-jetty</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jujin</groupId>
                <artifactId>freeway2-db</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Third-party -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>25</source>
                    <target>25</target>
                    <compilerArgs>
                        <arg>--enable-preview</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <argLine>--enable-preview</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>freeway2-commons</module>
        <module>freeway2-ioc</module>
        <module>freeway2-boot</module>
        <module>freeway2-web</module>
        <module>freeway2-web-engine-robaho</module>
        <module>freeway2-web-engine-undertow</module>
        <module>freeway2-web-engine-jetty</module>
        <module>freeway2-db</module>
    </modules>
</project>
