# ═══════════════════════════════════════════════════════════════
# Freeway 日志配置 — 参考模板
# ═══════════════════════════════════════════════════════════════
#
# 此文件是 Freeway JUL 日志体系的唯一配置文件。
# 由 JULEnhancer 在 bootstrap 阶段加载，替代 JUL 标准的 logging.properties。
#
# 系统属性（-D 参数）同名 key 会覆盖文件中的值，优先级：
#   -D 参数 > 环境变量 FREEWAY_* > freeway-log.properties > 代码默认值
#
# 每组属性也支持通过环境变量 FREEWAY_<KEY> 传入：
#   freeway.log.files       → FREEWAY_LOG_FILES
#   freeway.log.console.enabled → FREEWAY_LOG_CONSOLE_ENABLED
# 注意：带连字符的 key（如 max-size）不支持环境变量，需用 -D。


# ── 全局日志级别 ────────────────────────────────────────────────
#
# 最佳实践：
#   IDE/开发：INFO（默认）。想看细节用 freeway.log.level=DEBUG。
#   生产环境：INFO（不要在生产开 DEBUG）。排障时临时降级。
#
freeway.log.level=INFO


# ── 控制台日志 ──────────────────────────────────────────────────
#
# 控制台日志默认开启。12-factor app 要求日志走 stdout，容器环境
# （Docker/K8s）依赖控制台输出做日志采集，不建议关闭。
#
# console.level 不设时继承 root 级别（freeway.log.level）。典型
# 场景下两者一致就是最佳配置——开 DEBUG 时控制台也下放，不需要
# 单独设。按需调高（如只盯 ERROR）再单独配。
#
freeway.log.console.enabled=true
# freeway.log.console.level=   # 继承 root 级别

# 格式：auto = Freeway formatter + 颜色自适应
#   - 有 TTY 终端 → ANSI 色彩 + 单行紧凑格式
#   - 管道重定向 / Docker / K8s → 无色，不包含控制字符
#   - 设置 simple 则退回 JUL SimpleFormatter（极少需要）
#
# freeway.log.format=auto

# 颜色：auto = 跟随 format 行为。always 强制开启，never 强制关闭。
# 遵循 NO_COLOR 环境变量规范（https://no-color.org）。
#
# freeway.log.color=auto

# MDC 上下文：Mapped Diagnostic Context，每线程级的键值对上下文。
# 日志输出中 MDC 键值以 [key=value] 形式显示在 logger 名之后。
# 典型用途：分布式链路追踪、请求关联 —— 在请求入口将 traceId/requestId
# 放入 MDC，后续所有日志自动携带该上下文，无需每条日志手动传入。
# 默认 key 顺序: code(业务码) market(市场) diagId(诊断ID)，其余按字母序。
#
# freeway.log.mdc=true

# MDC 键显示优先级（逗号分隔），优先显示的键按此顺序排列，
# 其余键按字母序排列。默认值: code,market,diagId
# freeway.log.mdc.priority=code,market,diagId

# 调用者信息：每条日志解析 source class/method（供 formatter 使用）。
# 默认 true。日志量极大且自定义 formatter 不展示调用者时，设 false
# 可跳过每次日志的栈遍历，显著提升吞吐。
#
# freeway.log.caller-info=true


# ── 默认文件日志 ────────────────────────────────────────────────
#
# auto = 全托管：路径 logs/{app.name}.log，时间+大小双滚动，
# 自动 GZIP 归档，30 天清理。
#
# file=auto 就是最佳实践——开箱即用，不需要操心路径和旋转策略。
# 文件路径和安全地放日志之间没有偏门理由需要改它。
#
# 唯一需要 off 的场景：完全依赖 Docker 日志驱动且明确不想要文件。
#
freeway.log.file=auto
# freeway.log.file=off                          # 关闭文件日志
# freeway.log.file.max-size=104857600            # 100 MB 触发大小滚动
# freeway.log.file.max-history=30                # 保留天数
# freeway.log.file.compress=true                 # 归档后 GZIP
# freeway.log.file.flush-interval=250            # 批量刷盘间隔（毫秒）；0 = 每条日志立即刷盘（最保险、吞吐低）

# 注意：同时满足 file=auto（默认文件）和 files=...（多文件），
# 两者叠加不冲突——默认文件继续收根 logger 的消息，命名文件收
# 各自绑定的 logger 的消息。


# ── 多文件日志输出 ──────────────────────────────────────────────
#
# 当需要按 Logger 分离日志时，通过 files 声明命名日志文件：
#
# freeway.log.files=biz,audit
#
# 每个文件通过 freeway.log.file.<name>.* 配置：
# freeway.log.file.biz.path=logs/biz.log      # （必填）
# freeway.log.file.biz.logger=com.myapp.biz   # （可选，缺省 root）
# freeway.log.file.biz.level=INFO             # （可选，继承父 logger）
# freeway.log.file.biz.max-size=104857600
# freeway.log.file.biz.max-history=30
# freeway.log.file.biz.compress=true
# freeway.log.file.biz.flush-interval=250
#
# 最佳实践：命名文件设了 logger 后，该 logger 的日志不再传播到
# 根 logger，避免同一条消息出现在两个文件里。


# ── 按包/类细粒度级别 ──────────────────────────────────────────
#
# 格式：<logger-name>.level=<LEVEL>
#
# 最佳实践：
#   降低外部库的日志噪音（WARNING 以上才显示）：
#     com.zaxxer.hikari.level=WARNING
#     org.hibernate.level=WARNING
#
#   提高特定模块的日志级别（DEBUG 级别调细节）：
#     com.myapp.biz.service.level=FINE
#
# 支持 SLF4J 级别名（TRACE/DEBUG/INFO/WARN/ERROR）和 JUL 级别名
# （FINEST/FINE/INFO/WARNING/SEVERE），不区分大小写。
#
# com.jujin.freeway.http.level=FINE
# com.jujin.freeway.db.level=FINE
