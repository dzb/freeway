##################################################################
#  Freeway Configuration Reference
#  Copy to src/main/resources/application.properties
#  or application-{profile}.properties for profile-specific values.
#
#  Resolution order (lowest → highest priority):
#    1. application.properties
#    2. application.json
#    3. application-{profile}.properties
#    4. application-{profile}.json
#    5. Environment variables (FREEWAY_ prefix, configurable)
#    6. CLI args (--key=value, -Dkey=value)
#
#  Activate profile: --freeway.profile=dev
#  or env: FREEWAY_PROFILE=dev
##################################################################


# ================================
#  Framework / Boot
# ================================

# Env var prefix override — JVM system property only
# freeway.env.prefix=FREEWAY_


# ================================
#  Logging
# ================================
# Logging config lives in freeway-log.properties (classpath root).
# System properties (-D) and FREEWAY_ env vars override file values.
# See docs/freeway-log.properties.reference for all supported keys.
# com.myapp.audit.level=FINE


# ================================
#  HTTP / Web Server
# ================================

# Engine selected via module inclusion (.primary() mechanism).
# Default: FreewayHttpEngine (built-in, high-performance HTTP/2 + WebSocket).
# For Undertow: add UndertowModule to launcher — container auto-selects it.

# Server bind
# freeway.http.server.host=127.0.0.1
# freeway.http.server.port=8080
# freeway.http.server.backlog=0

# Shutdown grace period for in-flight requests (human-friendly duration).
# freeway.http.server.shutdown-grace=2s

# ================================
#  HTTP / Health
# ================================

# freeway.http.health.enabled=true
# freeway.http.health.path=/healthz

# ================================
#  HTTP / CORS
# ================================

# freeway.http.cors.enabled=true
# freeway.http.cors.allowed-origins=*
# freeway.http.cors.allowed-methods=GET, POST, PUT, DELETE, PATCH, OPTIONS
# freeway.http.cors.allowed-headers=Content-Type, Authorization
# freeway.http.cors.exposed-headers=
# freeway.http.cors.max-age=3600
# freeway.http.cors.allow-credentials=false


# ================================
#  HTTP / HTTPS (TLS)
# ================================

# Enable HTTPS — requires key-store and password. When enabled the
# existing HTTP port (default 8080) upgrades to TLS.
# freeway.http.ssl.enabled=false
# freeway.http.ssl.key-store=
# freeway.http.ssl.key-store-password=
# freeway.http.ssl.key-store-type=PKCS12
# freeway.http.ssl.http2=true    # HTTP/2 over TLS via ALPN


# ================================
#  Database / Connection (required)
# ================================

# JDBC URL (required — no default)
# freeway.db.url=jdbc:postgresql://localhost:5432/mydb

# Username (required — no default)
# freeway.db.username=postgres

# Password (default: empty)
# freeway.db.password=


# ================================
#  Database / Connection Pool
# ================================

# Pool engine selected via module inclusion (.primary() mechanism).
# Default: built-in pool (PoolDefault). For HikariCP: add HikariPoolModule to launcher.
# freeway.db.pool.max-size=10
# freeway.db.pool.min-idle=2
# freeway.db.pool.connection-timeout=10s
# freeway.db.pool.max-lifetime=30m
# freeway.db.pool.max-idle-time=10m
# freeway.db.pool.clean-interval=2m
# freeway.db.pool.health-check-query=
# freeway.db.pool.health-check-timeout=5s

# Statement query timeout
# freeway.db.query-timeout=15s


# ================================
#  Database / Dialect
# ================================

# Dialect id: postgresql (default) | mysql | sqlite
# Leave empty to auto-detect from JDBC URL.
# Detection: jdbc:postgresql:... → postgresql
#            jdbc:mysql:...      → mysql
#            jdbc:mariadb:...    → mysql
#            jdbc:h2:...         → postgresql (mysql if MODE=MySQL/MariaDB)
#            jdbc:sqlite:...     → sqlite
# freeway.db.dialect=


# ================================
#  Database / Schema (auto-DDL from @Table entities)
# ================================

# Enable auto-DDL at startup (dev: true, prod: false)
# freeway.db.schema.auto=true

# Comma-separated group filter — only run named SchemaEntity groups.
# Empty = all groups.
# freeway.db.schema.groups=


# ================================
#  Database / Migration (versioned SQL files)
# ================================

# Enable SQL migration runner
# freeway.db.migration.enabled=true

# Classpath directory for migration files (Flyway-compatible naming)
# freeway.db.migration.path=db/migration/

# Tracking table name
# freeway.db.migration.table=_migrations


# ================================
#  Kafka / Event Bridge (freeway-ext)
# ================================

# freeway.kafka.bootstrap-servers=localhost:9092
# freeway.kafka.group-id=freeway
# Comma-separated topic names for EventBus ↔ Kafka bridging.
# KafkaEventBridge sends matching events to these topics;
# KafkaSubscriber polls these topics and publishes to local EventBus.
# freeway.kafka.topics=
