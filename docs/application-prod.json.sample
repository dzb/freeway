{
	"freeway": {
		"http": {
			"server": {
				"host": "0.0.0.0",
				"shutdown-grace": "30s"
			},
			"health": {
				"enabled": "true",
				"path": "/healthz"
			},
			"cors": {
				"enabled": "true",
				"allowed-origins": "",
				"allow-credentials": "false"
			},
			"ssl": {
				"enabled": "true",
				"key-store": "",
				"key-store-password": "",
				"key-store-type": "PKCS12",
				"http2": "true"
			}
		},
		"db": {
			"url": "jdbc:postgresql://localhost:5432/mydb",
			"username": "",
			"password": "",
			"query-timeout": "15s",
			"pool.max-size": "20",
			"pool.min-idle": "4",
			"pool.connection-timeout": "30s",
			"pool.max-lifetime": "30m",
			"pool.max-idle-time": "10m",
			"pool.health-check-query": "SELECT 1",
			"pool.health-check-timeout": "5s",
			"schema.auto": "false",
			"migration.enabled": "true"
		}
	}
}
