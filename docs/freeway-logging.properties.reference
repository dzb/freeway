# ===============================================================
# Freeway logging — reference template
# ===============================================================
#
# This is Freeway's dedicated logging configuration file (most log keys may
# also live under freeway.log.* in the application's main configuration
# application.properties / application.json; this file outranks it — the more
# specific declaration wins).
# It is loaded by JULEnhancer during bootstrap and replaces JUL's standard
# logging.properties.
#
# The file must be named freeway-logging.properties and sit at the classpath
# root. The old name freeway-log.properties is no longer read: when it is still
# present, startup prints a one-line stderr notice — the configuration is not
# applied, but it does not fail silently either.
#
# System properties (-D) and environment variables override the file:
#   -D > FREEWAY_* environment > freeway-logging.properties
#     > application.* (freeway.log.* keys) > preset > code default
#
# Exception: the five keys below only honour -D/env and are ineffective in any
# file (they are read at class-load time, before file parsing). They are kept
# here only to document that they exist:
#   freeway.log.system / freeway.log.color / freeway.log.mdc /
#   freeway.log.mdc.priority / freeway.log.caller-info
#
# Every group also accepts environment variables:
#   freeway.log.files           -> FREEWAY_LOG_FILES
#   freeway.log.console.enabled -> FREEWAY_LOG_CONSOLE_ENABLED
# Note: keys containing a hyphen (max-size) cannot be expressed as environment
# variables; use -D.
# Note: per-logger levels (<logger>.level) exist only in this file — inside
# application.* they cannot be distinguished from ordinary dotted keys.


# ── Backend selection (only -D/env) ─────────────────────────────
#
# freeway.log.system=freeway   default: Freeway's JUL backend wins; a Logback/
#                              Log4j passed in transitively does not take over
#                              (startup reports it and the switch)
# freeway.log.system=auto      external provider first (logback > log4j2 >
#                              simple), Freeway's JUL backend as fallback
# freeway.log.system=logback   select explicitly (also log4j2 / simple / any
#                              provider class name); startup fails and names the
#                              missing dependency when it is absent
# -Dslf4j.provider=<class>     outranks this key (SLF4J's own escape hatch)
#
# Freeway's JUL enhancement (formatter/file/rotation) is configured only for its
# own JUL backend. With an external backend selected, java.util.logging is left
# untouched — no JUL handlers are attached and no records are forwarded. Add the
# standard jul-to-slf4j bridge yourself if JDK-internal JUL logging should
# follow your backend.


# ── Global level ────────────────────────────────────────────────
#
# Best practice:
#   IDE/development: INFO (default). Use freeway.log.level=DEBUG for detail.
#   Production: INFO (never DEBUG in production). Lower temporarily to debug.
#
freeway.log.level=INFO


# ── Console output ──────────────────────────────────────────────
#
# Console output is enabled by default. A 12-factor app logs to stdout, and
# container platforms (Docker/K8s) collect logs from the console — leave it on.
#
# console.level unset inherits the root level (freeway.log.level). Keeping the
# two equal is the best default; raise it explicitly (for example to only watch
# ERROR) when needed.
#
freeway.log.console.enabled=true
# freeway.log.console.level=   # inherits the root level

# Format: auto = Freeway formatter + adaptive colour
#   - TTY terminal   -> ANSI colour + compact single-line format
#   - pipe / Docker / K8s -> no colour, no control characters
#   - simple falls back to JUL's SimpleFormatter (rarely needed)
#
# freeway.log.format=auto

# Colour: auto follows format. always forces ANSI, never disables it.
# Honours the NO_COLOR convention (https://no-color.org).
# [only -D/env; ineffective in this file]
#
# freeway.log.color=auto

# MDC context: a per-thread key/value context. MDC entries are rendered as
# [key=value] after the logger name. Typical use: distributed tracing and
# request correlation — put traceId/requestId into MDC at the request entry and
# every later record carries it without per-call arguments.
# Without a priority list all MDC keys are alphabetical; highlight keys are
# declared by the application.
# [only -D/env; ineffective in this file]
#
# freeway.log.mdc=true

# MDC key display priority (comma-separated): listed keys come first in that
# order, unlisted keys stay alphabetical. Unset by default — the framework
# presets no key names.
# [only -D/env; ineffective in this file]
# freeway.log.mdc.priority=traceId,requestId

# Caller information: resolve the source class/method for every record (used by
# the formatter). Default true. When logging volume is huge and a custom
# formatter does not display callers, false skips the per-record stack walk and
# improves throughput significantly.
# [only -D/env; ineffective in this file]
#
# freeway.log.caller-info=true


# ── Default file logging ────────────────────────────────────────
#
# auto = fully managed: logs/{app.name}.log, time+size rotation, automatic GZIP
# archives, 30-day retention.
#
# file=auto is the best practice — it works out of the box; there is rarely a
# reason to hand-tune the path or rotation policy.
#
# The one reason to use off: deployments that rely entirely on a Docker log
# driver and explicitly do not want a file.
#
freeway.log.file=auto
# freeway.log.file=off                          # disable file logging
# freeway.log.file.max-size=104857600           # 100 MB triggers size rotation
# freeway.log.file.max-history=30               # days to keep archives
# freeway.log.file.compress=true                # GZIP after rotation
# freeway.log.file.flush-interval=250           # batch flush interval (ms); 0 = flush every record (safest, lower throughput)

# Note: file=auto (the default file) and files=... (named files) coexist: the
# default file keeps collecting root-logger records while each named file gets
# the records of its bound logger.


# ── Multi-file output ───────────────────────────────────────────
#
# Declare named log files when logs must be split by logger:
#
# freeway.log.files=biz,audit
#
# Each file is configured through freeway.log.file.<name>.*:
# freeway.log.file.biz.path=logs/biz.log      # (required)
# freeway.log.file.biz.logger=com.myapp.biz   # (optional, defaults to root)
# freeway.log.file.biz.level=INFO             # (optional, inherits parent)
# freeway.log.file.biz.max-size=104857600
# freeway.log.file.biz.max-history=30
# freeway.log.file.biz.compress=true
# freeway.log.file.biz.flush-interval=250
#
# Best practice: with a logger bound to a named file, its records no longer
# propagate to the root logger, so one message does not appear in two files.


# ── Per-package/class levels ────────────────────────────────────
#
# Format: <logger-name>.level=<LEVEL>
#
# Best practice:
#   Reduce noise from external libraries (WARNING and above only):
#     com.zaxxer.hikari.level=WARNING
#     org.hibernate.level=WARNING
#
#   Raise a module's level for detail:
#     com.myapp.biz.service.level=FINE
#
# Accepts SLF4J level names (TRACE/DEBUG/INFO/WARN/ERROR) and JUL level names
# (FINEST/FINE/INFO/WARNING/SEVERE), case-insensitive.
#
# com.jujin.freeway.http.level=FINE
# com.jujin.freeway.db.level=FINE
