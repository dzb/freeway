##################################################################
#  Freeway — Production Profile
#  Copy to src/main/resources/application-prod.properties
#  Activate: --freeway.profile=prod
#
#  Sensitive values (password, API keys) MUST be set via
#  environment variables, NOT in this file.
##################################################################

# ================================
#  Logging
# ================================

# Disable color for log aggregators
freeway.log.color=never


# ================================
#  HTTP / Web Server
# ================================
# Engine selected via module inclusion (.primary() mechanism):
#   default → FreewayHttpEngine; add UndertowModule for Undertow

# Bind to all interfaces — fronted by reverse proxy / load balancer
freeway.web.server.host=0.0.0.0

# Port set via env: FREEWAY_WEB_SERVER_PORT=8080
# freeway.web.server.port=8080

# Longer grace for in-flight requests during rolling deploys
freeway.web.server.shutdown-grace=30s

# ================================
#  HTTP / Health
# ================================

freeway.web.health.enabled=true
freeway.web.health.path=/healthz

# ================================
#  HTTP / CORS
# ================================

freeway.web.cors.enabled=true

# Explicit origin list — no wildcards in production
freeway.web.cors.allowed-origins=

freeway.web.cors.allow-credentials=false


# ================================
#  Database — PostgreSQL
# ================================

# Override via env: FREEWAY_DB_URL, FREEWAY_DB_USERNAME, FREEWAY_DB_PASSWORD
freeway.db.url=jdbc:postgresql://localhost:5432/mydb
freeway.db.username=
freeway.db.password=

# Production pool sizing
freeway.db.pool=hikari
freeway.db.pool.max-size=20
freeway.db.pool.min-idle=4
freeway.db.pool.connection-timeout=30s
freeway.db.pool.max-lifetime=30m
freeway.db.pool.max-idle-time=10m

# Validate connections before use
freeway.db.pool.health-check-query=SELECT 1
freeway.db.pool.health-check-timeout=5s

freeway.db.query-timeout=15s


# ================================
#  Database / Schema & Migration
# ================================

# Auto-DDL OFF — all schema changes via reviewed migration files
freeway.db.schema.auto=false

# Migration runner ON — applies versioned SQL from db/migration/
freeway.db.migration.enabled=true


# ================================
#  Kafka — production messaging
# ================================

# Override via env: FREEWAY_KAFKA_BOOTSTRAP_SERVERS, FREEWAY_KAFKA_TOPICS
# freeway.kafka.bootstrap-servers=
# freeway.kafka.group-id=my-app
# freeway.kafka.topics=
